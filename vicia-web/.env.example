# .env.example
# Copiez ce fichier vers .env (ou définissez ces variables au niveau
# du serveur/du service systemd) puis adaptez les valeurs à votre
# environnement. Le fichier .env n'est pas lu automatiquement par PHP
# natif ; sur un hébergement Apache classique, définissez plutôt ces
# variables via SetEnv dans la configuration du VirtualHost, ou
# exportez-les dans le service systemd du démon MQTT (voir README).

APP_ENV=production
APP_URL=https://votre-domaine.example.com
APP_KEY=changez-cette-cle-secrete-en-production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vicia_home
MYSQL_USER=vicia_user
MYSQL_PASSWORD=changez-ce-mot-de-passe

MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USER=vicia_web
MQTT_PASS=changez-ce-mot-de-passe

# Module Vicia Home AI — fournisseur LLM (openai ou gemini), clé jamais
# codée en dur, jamais journalisée. Sans ces variables, l'assistant
# reste fonctionnel (commandes, questions, analyses) mais formule ses
# réponses en mode de repli sobre plutôt qu'en langage naturel avancé.
AI_LLM_PROVIDER=openai
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_BASE_URL=
