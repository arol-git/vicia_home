# public/.htaccess
# Redirige toutes les requêtes qui ne correspondent pas à un fichier
# ou un dossier existant vers le front controller (public/index.php).
# 
# Note: Si DocumentRoot = racine/ du projet, les requêtes /api/* ne
# passent jamais par ce fichier (traitées par /.htaccess).
# Si DocumentRoot = public/, les requêtes /api/* sont traitées ici.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /api/v1/* est redirigé vers ../api/index.php
    # Cela s'applique UNIQUEMENT si DocumentRoot est public/
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ ../api/index.php [L,QSA]

    # Sinon, si la requête ne correspond à aucun fichier/dossier,
    # redirige vers le front controller Web (public/index.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Empêche l'exploration des répertoires
Options -Indexes

# En-têtes de sécurité de base et PWA
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Service Worker et Manifest doivent être accessibles partout
    <FilesMatch "\.(js|json)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # Types MIME pour PWA
    AddType application/json .json
    AddType application/javascript .js
    AddType image/png .png
    AddType image/webp .webp
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
