# public/.htaccess
# Redirige toutes les requêtes qui ne correspondent pas à un fichier
# ou un dossier existant vers le front controller (public/index.php).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirige l'API vers le front controller API avant le catch-all Web.
    RewriteRule ^api/(.*)$ ../api/index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Empêche l'exploration des répertoires
Options -Indexes

# En-têtes de sécurité de base
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
