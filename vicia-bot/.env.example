# .env.example
# Copiez ce fichier vers .env puis renseignez vos valeurs. Le fichier
# .env ne doit jamais être versionné (voir .gitignore).

# --- Application -------------------------------------------------------
APP_ENV=production
APP_TIMEZONE=Africa/Douala
# Clé longue et aléatoire (32+ caractères), sert au chiffrement des
# jetons API stockés (Bot\Services\TokenVault) — jamais la valeur
# d'exemple ci-dessous en production.
APP_KEY=changez-cette-cle-32-caracteres-minimum

# --- Telegram ------------------------------------------------------------
# Jeton du bot obtenu auprès de @BotFather — jamais écrit en dur dans le code.
TELEGRAM_BOT_TOKEN=000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret partagé utilisé pour vérifier l'origine des requêtes du webhook
# Telegram (paramètre secret_token de setWebhook).
TELEGRAM_WEBHOOK_SECRET=changez-ce-secret-webhook

# --- API REST Vicia Home ---------------------------------------------------
VICIA_API_BASE_URL=https://votre-domaine.example.com/api/v1
# Secret partagé HMAC pour authentifier les notifications poussées
# envoyées par mqtt/subscriber.php (côté plateforme) vers
# public/webhook-alert.php (côté bot). Doit être identique des deux côtés.
VICIA_ALERT_WEBHOOK_SECRET=changez-ce-secret-partage

# --- Base de données du bot (vicia_bot — distincte de vicia_home) ------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vicia_bot
MYSQL_USER=vicia_bot_user
MYSQL_PASSWORD=changez-ce-mot-de-passe

# --- Journalisation --------------------------------------------------------
LOG_LEVEL=info
LOG_CHANNEL=bot

# --- Limitation de débit -----------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
