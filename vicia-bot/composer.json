{
    "name": "vicia-home/telegram-bot",
    "description": "Bot Telegram officiel de la plateforme Vicia Home — pilotage de la maison, alertes de sécurité et automatisation, via l'API REST de la plateforme.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "irazasyed/telegram-bot-sdk": "^3.13",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.5",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Bot\\": "bot/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bot\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
